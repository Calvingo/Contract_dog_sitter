GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# One or more comma-separated recipients to receive submission notifications
ADMIN_EMAIL=admin1@gmail.com,admin2@gmail.com

# Random secret for signing admin decision links (min 16 characters)
APP_SECRET=your_random_secret_at_least_16_chars

# Public URL of your deployed site (required for admin email buttons)
# Example: https://contract-dog-sitter.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
