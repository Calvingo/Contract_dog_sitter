GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# One or more comma-separated recipients to receive submission notifications
# Comma-separated — no spaces between addresses
ADMIN_EMAIL=admin1@gmail.com,admin2@gmail.com,admin3@gmail.com

# Random secret for signing admin decision links (min 16 characters)
APP_SECRET=your_random_secret_at_least_16_chars
CUSTOMER_SESSION_SECRET=another_random_secret_at_least_16_chars
LOGIN_TOKEN_TTL_MINUTES=30

# Postgres connection strings
# Use the pooled URL for runtime and direct URL for migrations.
DATABASE_URL=postgresql://user:password@host:6543/database?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/database

# Public URL for decision links in admin emails (must be real https URL, NOT the text "NEXT_PUBLIC_APP_URL")
APP_BASE_URL=https://contract-dog-sitter.vercel.app

# Optional fallback — same real URL as above
NEXT_PUBLIC_APP_URL=https://contract-dog-sitter.vercel.app
